# 复制这个文件为 .env 再填。.env 已在 .gitignore 里，绝不上传 GitHub。

# mt5 = 真实行情（需要 MT5 软件开着并登录模拟账户）
# demo = 随机演示数据（没装 MT5 时测试用，数字不是真行情）
DATA_SOURCE=mt5

# 在 MT5「市场报价」里看金价的确切名称，例如 XAUUSD、XAUUSD.m、GOLD
MT5_SYMBOL=XAUUSD
# 有多个 MT5 时才需要填 terminal64.exe 的完整路径
MT5_PATH=
# 经纪商服务器时区（比 UTC 快几小时）。留 auto 会自动判断，判断不准时再手动填 2 或 3
MT5_SERVER_UTC_OFFSET_HOURS=auto

# Telegram：找 @BotFather 建机器人拿 token；给机器人发一句话后用 getUpdates 查 chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 本地 AI（Ollama）。没装也能跑，会改用文字模板
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

ANALYSIS_INTERVAL_MIN=15
TICK_INTERVAL_SEC=5
# 整数关口间距（金价每 50 美元一个）
ROUND_LEVEL_STEP=50
ALERT_COOLDOWN_MIN=60
MAX_ALERTS_PER_DAY=20
